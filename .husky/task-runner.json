{
   "tasks": [
      {
         "name": "Run csharpier on staged files",
         "group": "pre-commit",
         "command": "csharpier",
         "args": ["format", "${staged}"],
         "include": ["**/*.cs"]
      },
      {
         "name": "Check csharpier on entire repository",
         "group": "verify",
         "command": "csharpier",
         "args": ["format", "."],
         "include": ["**/*.cs"]
      }
   ]
}
